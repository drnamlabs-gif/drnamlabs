---
import site from '../data/site.json';
const { current } = Astro.props;
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand" aria-label="Home">
      <span class="nav__mark" aria-hidden="true">&#920;</span>
      <span class="nav__name">{site.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav__link', { 'is-current': current === item.label }]}
          aria-current={current === item.label ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button id="theme-toggle" class="nav__theme" type="button" aria-label="Toggle colour theme">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.6rem;
  }

  /* The brand must not be squeezed by a long link row. */
  .nav__brand { flex: 0 0 auto; }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    border: 0;
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav__mark {
    font-family: var(--serif);
    font-size: 1.28rem;
    color: var(--accent);
    line-height: 1;
  }

  .nav__name { font-size: 0.95rem; }

  /* The link row scrolls sideways rather than pushing the page wider, so
     adding a nav item can never reintroduce a horizontal page scrollbar on a
     narrow screen. The theme button sits outside it and always stays put. */
  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-inline-start: auto;
    padding-block: 0.75rem;   /* keeps focus rings from being clipped */
  }
  .nav__links::-webkit-scrollbar { display: none; }

  .nav__link {
    border: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    padding-block: 0.2rem;
    border-bottom: 1.5px solid transparent;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .nav__link:hover { color: var(--text); }
  .nav__link.is-current { color: var(--text); border-bottom-color: var(--accent); }

  .nav__theme {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .nav__theme:hover { color: var(--text); border-color: var(--border-strong); }

  @media (max-width: 34rem) {
    .nav__name { display: none; }
    .nav__links { gap: 1rem; }
    .nav__link { font-size: 0.82rem; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const now = root.getAttribute('data-theme') ?? (systemDark ? 'dark' : 'light');
      const next = now === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (_) {}
    });
  })();
</script>
