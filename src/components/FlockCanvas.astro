---
// Decorative illustration for the VitaNova tile: loose points drifting, then
// pulled into a couple of clusters that hold briefly and split again. Nothing
// here is real simulation output — it's a generic stand-in for "flocks that
// divide", same spirit as PhasePortrait.
---

<canvas class="fc" role="img" aria-label="Animated illustration: scattered points gathering into clusters, holding, then dividing again."></canvas>

<style>
  .fc { width: 100%; height: 100%; display: block; }
</style>

<script is:inline>
  (() => {
    const canvas = document.querySelector('.fc');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const N = 22;
    const CYCLE = 9; // seconds: scatter -> cluster -> hold -> split

    let seeds = Array.from({ length: N }, (_, i) => ({
      a: Math.random() * Math.PI * 2,
      r: 0.35 + Math.random() * 0.55,
      speed: 0.15 + Math.random() * 0.25,
      group: i % 2,
    }));

    let accent = '#888', border = '#ccc';
    const readPalette = () => {
      const cs = getComputedStyle(document.documentElement);
      accent = cs.getPropertyValue('--accent').trim() || accent;
      border = cs.getPropertyValue('--border').trim() || border;
    };

    let W = 0, H = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      if (!rect.width) return;
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Phase in [0,1): 0-0.4 scattered, 0.4-0.6 clustering, 0.6-0.85 held, 0.85-1 splitting.
    function positions(phase) {
      const cx = W / 2, cy = H / 2;
      const cluster = 0.5 - Math.abs(((phase + 0.5) % 1) - 0.5) * 2; // 0..1..0 easing knob unused directly
      const pull = phase < 0.4
        ? 0
        : phase < 0.6
          ? (phase - 0.4) / 0.2
          : phase < 0.85
            ? 1
            : 1 - (phase - 0.85) / 0.15;

      const targets = [
        { x: cx - Math.min(W, H) * 0.18, y: cy },
        { x: cx + Math.min(W, H) * 0.18, y: cy },
      ];

      return seeds.map((s) => {
        const scatterR = Math.min(W, H) * 0.4 * s.r;
        const sx = cx + Math.cos(s.a) * scatterR;
        const sy = cy + Math.sin(s.a) * scatterR * 0.85;
        const t = targets[s.group];
        return {
          x: sx + (t.x - sx) * pull,
          y: sy + (t.y - sy) * pull,
        };
      });
    }

    function drawFrame(t) {
      ctx.clearRect(0, 0, W, H);
      const phase = (t / CYCLE) % 1;
      const pts = positions(phase);

      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.5;
      ctx.strokeRect(1, 1, Math.max(0, W - 2), Math.max(0, H - 2));
      ctx.globalAlpha = 1;

      const r = Math.max(2, Math.min(W, H) * 0.018);
      ctx.fillStyle = accent;
      for (const p of pts) {
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = null;

    const renderStatic = () => { resize(); readPalette(); if (W) drawFrame(CYCLE * 0.72); };

    const loop = (tsMs) => {
      const t = tsMs / 1000;
      if (W) drawFrame(t);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (raf !== null) return;
      if (reduced.matches) { renderStatic(); return; }
      raf = requestAnimationFrame(loop);
    };
    const stop = () => { if (raf !== null) { cancelAnimationFrame(raf); raf = null; } };
    const boot = () => { resize(); readPalette(); if (reduced.matches) renderStatic(); else start(); };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? start() : stop();
      }, { threshold: 0.05 }).observe(canvas);
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { resize(); if (reduced.matches) renderStatic(); }, 120);
    });

    new MutationObserver(() => { readPalette(); if (reduced.matches) renderStatic(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => { readPalette(); if (reduced.matches) renderStatic(); });
    reduced.addEventListener('change', () => { stop(); boot(); });

    boot();
  })();
</script>
