---
// Decorative illustration for the Baldwin-effect tile: two smooth curves
// trading off as they drift across the frame, standing in for the
// self-teaching / social-learning crossover. Illustrative only — no real
// fitness numbers, same spirit as PhasePortrait.
---

<canvas class="lc" role="img" aria-label="Animated illustration: two curves rising and falling out of phase, crossing over repeatedly."></canvas>

<style>
  .lc { width: 100%; height: 100%; display: block; }
</style>

<script is:inline>
  (() => {
    const canvas = document.querySelector('.lc');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let accentA = '#888', accentB = '#aaa', border = '#ccc';
    const readPalette = () => {
      const cs = getComputedStyle(document.documentElement);
      accentA = cs.getPropertyValue('--accent').trim() || accentA;
      accentB = cs.getPropertyValue('--amber').trim() || accentB;
      border = cs.getPropertyValue('--border').trim() || border;
    };

    let W = 0, H = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      if (!rect.width) return;
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const curveA = (x, t) => 0.5 + 0.32 * Math.sin(x * 2.4 + t * 0.6);
    const curveB = (x, t) => 0.5 + 0.32 * Math.sin(x * 2.4 + t * 0.6 + Math.PI * 0.85);

    function drawCurve(fn, t, colour) {
      ctx.beginPath();
      const steps = 60;
      for (let i = 0; i <= steps; i++) {
        const x = i / steps;
        const y = fn(x, t);
        const px = x * W;
        const py = (1 - y) * H;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.strokeStyle = colour;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function drawFrame(t) {
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = border;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1;
      ctx.strokeRect(1, 1, Math.max(0, W - 2), Math.max(0, H - 2));
      ctx.globalAlpha = 1;

      drawCurve(curveA, t, accentA);
      drawCurve(curveB, t, accentB);
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = null;

    const renderStatic = () => { resize(); readPalette(); if (W) drawFrame(2.0); };

    const loop = (tsMs) => {
      const t = tsMs / 1000;
      if (W) drawFrame(t);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (raf !== null) return;
      if (reduced.matches) { renderStatic(); return; }
      raf = requestAnimationFrame(loop);
    };
    const stop = () => { if (raf !== null) { cancelAnimationFrame(raf); raf = null; } };
    const boot = () => { resize(); readPalette(); if (reduced.matches) renderStatic(); else start(); };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? start() : stop();
      }, { threshold: 0.05 }).observe(canvas);
    }
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { resize(); if (reduced.matches) renderStatic(); }, 120);
    });

    new MutationObserver(() => { readPalette(); if (reduced.matches) renderStatic(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => { readPalette(); if (reduced.matches) renderStatic(); });
    reduced.addEventListener('change', () => { stop(); boot(); });

    boot();
  })();
</script>
