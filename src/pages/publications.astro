---
import Base from '../layouts/Base.astro';
import pubs from '../data/publications.json';
import site from '../data/site.json';

const total = pubs.groups.reduce((n, g) => n + g.items.length, 0);
---

<Base
  current="Publications"
  title="Publications"
  description="Peer-reviewed publications, preprints and manuscripts under review by Nam H. Le."
>
  <section class="head">
    <div class="wrap">
      <h1>Publications</h1>
      <p class="lede">
        {total} items. GECCO, PPSN, IEEE CEC, EvoStar and ALIFE are the flagship peer-reviewed
        venues of evolutionary computation and artificial life; full papers there are archival and
        competitively reviewed.
      </p>
      <p class="head__links small">
        <a href={site.links.scholar}>Google Scholar</a>
        <a href={site.links.github}>GitHub</a>
      </p>
    </div>
  </section>

  {pubs.groups.map((group) => (
    <section id={group.id}>
      <div class="wrap">
        <p class="eyebrow">{group.title}</p>
        <ol class="pubs">
          {group.items.map((item) => (
            <li class="pub">
              <p class="pub__authors small muted">{item.authors}</p>
              <h3 class="pub__title">{item.title}</h3>
              <p class="pub__venue">
                <em>{item.venue}</em>{item.year ? `, ${item.year}` : ''}
                {item.award && <span class="pub__award">{item.award}</span>}
              </p>
              {item.links && (
                <p class="pub__links small">
                  {item.links.map((l) => (<a href={l.href}>{l.label}</a>))}
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) 2.5rem; }
  .head h1 { margin-bottom: 0.7rem; }
  .head__links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.25rem; }

  section { padding-block: 2.5rem; }

  .pubs { list-style: none; margin: 0; padding: 0; }

  .pub {
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .pub:first-child { border-top: 0; padding-top: 0; }

  .pub__authors { margin: 0 0 0.2rem; max-width: none; }
  .pub__title {
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    line-height: 1.35;
    max-width: 46rem;
  }
  .pub__venue { margin: 0; color: var(--text-soft); font-size: 0.92rem; max-width: 46rem; }

  .pub__award {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.06rem 0.45rem;
    border: 1px solid var(--amber);
    border-radius: 2px;
    color: var(--amber);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    vertical-align: 1px;
  }

  .pub__links { display: flex; flex-wrap: wrap; gap: 0.95rem; margin: 0.45rem 0 0; }
</style>
