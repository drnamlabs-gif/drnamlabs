---
import Base from '../layouts/Base.astro';
import pubs from '../data/publications.json';
import site from '../data/site.json';

const total = pubs.groups.reduce((n, g) => n + g.items.length, 0);
---

<Base
  current="Publications"
  title="Publications"
  description="Peer-reviewed publications, preprints and manuscripts under review by Nam H. Le."
>
  <section class="head">
    <div class="wrap">
      <h1>Publications</h1>
      <p class="lede">
        {total} items, grouped by the question they ask rather than by where they appeared.
        The first topic is the current work; within each topic, newest first.
      </p>
      <nav class="topics small" aria-label="Topics">
        {pubs.groups.map((group) => (
          <a href={`#${group.id}`}>{group.title}<span class="topics__n"> {group.items.length}</span></a>
        ))}
      </nav>
      <p class="head__links small">
        <a href={site.links.scholar}>Google Scholar</a>
        <a href={site.links.github}>GitHub</a>
        <button type="button" class="linkish" data-pubs="open">Expand all</button>
        <button type="button" class="linkish" data-pubs="close">Collapse all</button>
      </p>
    </div>
  </section>

  {pubs.groups.map((group, i) => (
    <section id={group.id} class="topic">
      <div class="wrap">
        <details class="topic__box" open={i === 0}>
          <summary class="topic__head">
            <h2 class="topic__title">{group.title}</h2>
            <span class="topic__count">{group.items.length}</span>
            {group.blurb && <p class="topic__blurb">{group.blurb}</p>}
          </summary>
          <ol class="pubs">
            {group.items.map((item) => (
              <li class="pub">
                <p class="pub__authors small muted">{item.authors}</p>
                <h3 class="pub__title">{item.title}</h3>
                <p class="pub__venue">
                  <em>{item.venue}</em>{item.year ? `, ${item.year}` : ''}
                  {item.award && <span class="pub__award">{item.award}</span>}
                </p>
                {item.links && (
                  <p class="pub__links small">
                    {item.links.map((l) => (<a href={l.href}>{l.label}</a>))}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </details>
      </div>
    </section>
  ))}
</Base>

<script>
  const boxes = Array.from(document.querySelectorAll('details.topic__box'));

  document.querySelectorAll('[data-pubs]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('data-pubs') === 'open';
      boxes.forEach((b) => { (b as HTMLDetailsElement).open = open; });
    });
  });

  // A topic link in the nav (or a shared #anchor) opens that topic.
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const section = document.getElementById(id);
    const box = section?.querySelector('details.topic__box') as HTMLDetailsElement | null;
    if (box) box.open = true;
  }
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4rem) 2rem; }
  .head h1 { margin-bottom: 0.7rem; }
  .head__links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1.25rem; margin-top: 1.5rem; }

  .linkish {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin-top: 1.5rem;
    max-width: 54rem;
  }
  .topics a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-soft);
  }
  .topics a:hover { color: var(--text); border-color: var(--border-strong); background: var(--bg-sunken); }
  .topics__n { color: var(--text-muted); font-variant-numeric: tabular-nums; }

  section.topic { padding-block: 0; }
  section.topic:first-of-type { padding-top: 0.5rem; }

  .topic__box {
    border-top: 1px solid var(--border-strong);
    padding-block: 1.6rem;
  }

  .topic__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    cursor: pointer;
    list-style: none;
  }
  .topic__head::-webkit-details-marker { display: none; }
  .topic__head:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .topic__title {
    grid-column: 1;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 3.1vw, 1.9rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 40rem;
    position: relative;
    padding-left: 1.5rem;
  }
  /* The disclosure triangle, drawn so it lines up with the first line of the title. */
  .topic__title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 0.46em;
    height: 0.46em;
    border-right: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
    transition: transform 0.18s ease;
  }
  .topic__box[open] .topic__title::before { transform: rotate(45deg); }
  .topic__head:hover .topic__title { color: var(--accent); }

  .topic__count {
    grid-column: 2;
    grid-row: 1;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .topic__blurb {
    grid-column: 1;
    margin: 0.55rem 0 0 1.5rem;
    max-width: 42rem;
    color: var(--text-soft);
    font-size: 0.96rem;
  }

  .pubs { list-style: none; margin: 1.6rem 0 0 1.5rem; padding: 0; }

  @media (max-width: 34rem) {
    .topic__blurb, .pubs { margin-left: 0; }
  }

  .pub {
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .pub:first-child { border-top: 0; padding-top: 0; }

  .pub__authors { margin: 0 0 0.2rem; max-width: none; }
  .pub__title {
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    line-height: 1.35;
    max-width: 46rem;
  }
  .pub__venue { margin: 0; color: var(--text-soft); font-size: 0.92rem; max-width: 46rem; }

  .pub__award {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.06rem 0.45rem;
    border: 1px solid var(--amber);
    border-radius: 2px;
    color: var(--amber);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    vertical-align: 1px;
  }

  .pub__links { display: flex; flex-wrap: wrap; gap: 0.95rem; margin: 0.45rem 0 0; }
</style>
