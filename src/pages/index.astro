---
import Base from '../layouts/Base.astro';
import PhasePortrait from '../components/PhasePortrait.astro';
import LearningCanvas from '../components/LearningCanvas.astro';
import site from '../data/site.json';

const tiles = [
  {
    kind: 'Artificial life',
    title: 'Symbolic reasoning in embodied agents',
    cls: 'b-a',
    href: '/research/#symbolic',
    media: 'video',
    src: '/research/oddworld-loop',
    alt: 'Agents in a 3D diorama learning, over training, to pick out the one object in a cluster that differs from the rest.',
  },  {
    kind: 'Embodied agents',
    title: 'Language-driven control, in a body',
    cls: 'b-c',
    href: '/research/#embodied',
    media: 'video',
    src: '/research/embodied-loop',
    alt: 'A Pac-Man-style agent following a language instruction through a maze.',
  },
  {
    kind: 'Artificial life',
    title: 'Flocks that reproduce as units',
    cls: 'b-d',
    href: '/research/#eti',
    media: 'video',
    src: '/research/vitanova-loop',
    alt: 'A real VitaNova run: a collective disperses, re-aggregates into a ring, then splits into two daughter collectives.',
  },
  {
    kind: 'Computational intelligence',
    title: 'Learning, evolution, and the Baldwin effect',
    cls: 'b-e',
    href: '/research/#learning',
    media: 'learning',
  },
  {
    kind: 'Markets',
    title: 'Finding the phase boundary in price',
    cls: 'b-f',
    href: '/research/#markets',
    media: 'portrait',
  },
];

const software = [
  {
    kind: 'Language model · bioelectricity',
    title: 'CellBio-GPT: a 40M model refereed by a tissue simulator',
    href: '/portfolio/#cellbio-gpt',
    src: '/portfolio/cellbio-pipeline.png',
    alt: 'Pipeline diagram of CellBio-GPT, from PubMed abstracts to a simulator-scored reward.',
  },
  {
    kind: 'iPhone and iPad · Swift',
    title: 'BunnyQuant: native charts and risk levels',
    href: '/portfolio/#bunnyquant-ios',
    src: '/portfolio/bq-us-01-watchlist.jpg',
    alt: 'The BunnyQuant app watchlist on an iPhone.',
  },
  {
    kind: 'iPhone and iPad · Swift',
    title: 'BunnyQuantVN: the same, for VN30, in Vietnamese',
    href: '/portfolio/#bunnyquantvn-ios',
    src: '/portfolio/bq-vn-01-watchlist.jpg',
    alt: 'The BunnyQuantVN app watchlist on an iPhone.',
  },
];

const selected = [
  {
    year: '2026',
    title: "Who Pays for the Knowledge Models Copy? Model Collapse as Rogers' Paradox",
    note: 'Language models trained on each other\'s output forget, rare knowledge first — the same trap cultural evolution calls Rogers\' paradox, and the same way out: someone has to keep learning for themselves.',
    venue: 'Zenodo',
    href: 'https://doi.org/10.5281/zenodo.23298661',
  },
  {
    year: '2026',
    title: 'Oddworld: Relational Reasoning Emerges under Implicit Selection in Evolving Attention Agents',
    note: 'An evolved attention network — its weights are the genome — learns to spot the odd one out, with no fitness function ever scoring accuracy.',
    venue: 'Zenodo',
    href: 'https://doi.org/10.5281/zenodo.23291253',
  },
  {
    year: '2025',
    title: 'Emergent Collective Reproduction via Evolving Neuronal Flocks',
    note: 'Neural agents self-organise into flocks that divide — an evolutionary transition in individuality, arrived at without being asked for.',
    venue: 'Northeast Journal of Complex Systems',
    href: 'https://orb.binghamton.edu/nejcs/vol7/iss2/8',
  },
  {
    year: '2025',
    title: 'Decoupling Representation and Learning in Genetic Programming',
    note: 'The LaSER approach: let the program describe the representation and let a learner do the fitting.',
    venue: 'GPTP · arXiv:2505.17309',
    href: 'https://arxiv.org/abs/2505.17309',
  },
  {
    year: '2025',
    title: 'Giving Simulated Cells a Voice',
    note: 'Evolving prompt-to-intervention models for cellular control.',
    venue: 'GECCO Companion, ACM',
    href: 'https://arxiv.org/abs/2505.02766',
  },
];
---

<Base current="Home">
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="hero__kicker mono">{site.name}, {site.credential} · AI researcher · University of Vermont</p>
        <h1>Telling biobots what to do, in plain English<span class="hero__dot">.</span></h1>
        <p class="lede hero__thesis">
          Language-driven control of xenobots and simulated cell collectives. I build adaptive AI
          — language models, reinforcement learning and open-ended search — and check that it was
          the sentence that did it.
        </p>
        <ul class="hero__chips mono">
          <li>Xenobots</li>
          <li>Language models</li>
          <li>AI for science</li>
          <li>Reinforcement learning</li>
          <li>Open-ended search</li>
          <li>Adaptive agents</li>
        </ul>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/research/">Research</a>
          <a class="btn" href="/portfolio/">Software</a>
          <a class="btn" href={`mailto:${site.email}`}>Contact</a>
        </div>
      </div>
      <div class="hero__viz hero__pair">
        <a class="hero__clip pair__a" href="/research/#living" aria-label="Steering biobots with language">
          <video class="tile__vid" muted loop playsinline preload="metadata" aria-label="A biobot’s real archival trajectory, before and after a natural-language instruction to move faster, slower, or stop.">
            <source src="/research/living-loop.webm" type="video/webm" />
            <source src="/research/living-loop.mp4" type="video/mp4" />
          </video>
          <span class="hero__cap mono">Xenobots, steered by a sentence</span>
        </a>
        <a class="hero__clip pair__b" href="/research/#verify" aria-label="Simulated tissue engineering: one phrase changed, the tissue flips">
          <video class="tile__vid" muted loop playsinline preload="metadata" aria-label="Two requests three words apart — raise the voltage at the core, or around the perimeter — producing opposite tissue states.">
            <source src="/research/p2i-verify-loop.webm" type="video/webm" />
            <source src="/research/p2i-verify-loop.mp4" type="video/mp4" />
          </video>
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Research, at a glance</p>
      <div class="bento">
        {tiles.map((t) => (
          <a class={`tile ${t.cls}`} href={t.href} aria-label={`${t.kind}: ${t.title}`}>
            <div class="tile__media">
              {t.media === 'video' && (
                <video class="tile__vid" muted loop playsinline preload="metadata" aria-label={t.alt}>
                  <source src={`${t.src}.webm`} type="video/webm" />
                  <source src={`${t.src}.mp4`} type="video/mp4" />
                </video>
              )}
              {t.media === 'learning' && <LearningCanvas />}
              {t.media === 'portrait' && <PhasePortrait caption={false} />}
            </div>
            <div class="tile__label">
              <p class="tile__kind mono">{t.kind}</p>
              <p class="tile__title">{t.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Software that runs</p>
      <div class="stage">
        <a class="stage__cell stage__cell--doc" href="/portfolio/#cellbio-gpt">
          <img src="/portfolio/cellbio-pipeline.png" width="1445" height="564" alt="Pipeline diagram of CellBio-GPT, from PubMed abstracts to a simulator-scored reward." loading="lazy" />
          <div class="tile__label">
            <p class="tile__kind mono">Language model · bioelectricity</p>
            <p class="tile__title">CellBio-GPT: a 40M model, refereed by a tissue simulator</p>
          </div>
        </a>
        <a class="stage__cell stage__cell--phones" href="/portfolio/#bunnyquant-ios">
          <div class="phones">
            <img class="phones__a" src="/portfolio/bq-us-01-watchlist.jpg" width="660" height="1319" alt="The BunnyQuant app watchlist on an iPhone." loading="lazy" />
            <img class="phones__b" src="/portfolio/bq-vn-01-watchlist.jpg" width="660" height="1319" alt="The BunnyQuantVN app watchlist on an iPhone." loading="lazy" />
          </div>
          <div class="tile__label">
            <p class="tile__kind mono">iPhone and iPad · Swift</p>
            <p class="tile__title">BunnyQuant and BunnyQuantVN: native charts, entry and risk levels</p>
          </div>
        </a>
      </div>
      <p><a href="/portfolio/">All software &rarr;</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">One question, several substrates</p>
      <div class="thesis">
        <p class="wide">
          A flock of cells and a market are both collectives of parts that adapt to one another
          without a plan. In both, the interesting events are not the averages but the
          <strong>transitions</strong> — the moment a population commits to a new organisation, the
          moment a regime turns over. My work is about characterising those transitions well enough
          to detect them, and in the case of living matter, well enough to
          <em>cause</em> them.
        </p>
        <p class="wide">
          The methods travel across them: evolutionary computation, dynamical-systems analysis,
          and — more recently — foundation models used not as oracles but as
          <strong>interfaces</strong>, translating human intent into interventions on a system that
          has no notion of what we want.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <ol class="sel">
        {selected.map((s) => (
          <li class="sel__item">
            <span class="sel__year mono">{s.year}</span>
            <div>
              <h3 class="sel__title"><a href={s.href}>{s.title}</a></h3>
              <p class="sel__note">{s.note}</p>
              <p class="sel__venue small muted">{s.venue}</p>
            </div>
          </li>
        ))}
      </ol>
      <p><a href="/publications/">All publications &rarr;</a></p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const videos = document.querySelectorAll('video.tile__vid');
    if (!videos.length) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return; // leave paused on the first frame

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) e.target.play().catch(() => {});
          else e.target.pause();
        }
      }, { threshold: 0.15 });
      videos.forEach((v) => io.observe(v));
    } else {
      videos.forEach((v) => v.play().catch(() => {}));
    }
  })();
</script>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 5.5rem) 3.5rem; }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    color: var(--text-muted);
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .hero h1 { margin-bottom: 0.5rem; }
  .hero__dot { color: var(--accent); }

  .hero__thesis { margin-bottom: 1.35rem; }
  .hero__blurb { color: var(--text-soft); max-width: 33rem; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.75rem; }

  .hero__viz { display: flex; justify-content: flex-start; }

  /* The animation leads, on every width — it's the first thing a visitor
     sees, ahead of the name and the long thesis line below it. */
  @media (max-width: 52rem) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__actions { margin-bottom: 0.5rem; }
  }

  .hero h1 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); line-height: 1.12; }
  .hero__chips {
    display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; margin: 0 0 0; padding: 0;
    font-size: 0.72rem; letter-spacing: 0.04em; color: var(--text-muted);
  }
  .hero__chips li { border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.7rem; }
  .hero__clip {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9;
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: #0b100e;
  }
  .hero__clip:hover { border-color: var(--accent); }
  .hero__pair { position: relative; width: 100%; aspect-ratio: 4 / 3; display: block; }
  .pair__a { position: absolute; left: 0; top: 0; width: 84%; aspect-ratio: 16 / 9; }
  .pair__b {
    position: absolute; right: 0; bottom: 0; width: 58%; aspect-ratio: 960 / 690; z-index: 2;
    background: #fbfaf7; box-shadow: 0 22px 50px -14px rgba(0,0,0,0.7);
  }
  .hero__clip .tile__vid { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pair__a { background: #0b100e; }
  .hero__cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0.6rem 0.9rem;
    font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: #fff;
    background: linear-gradient(transparent, rgba(8,12,18,0.78));
  }
  .hero { position: relative; }
  .hero::before {
    content: ''; position: absolute; inset: -10% -5% auto -5%; height: 90%; pointer-events: none; z-index: -1;
    background: radial-gradient(60% 60% at 75% 40%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%);
  }
  .hero__clip { box-shadow: 0 18px 60px -20px color-mix(in srgb, var(--accent) 45%, transparent); }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 11.5rem;
    gap: 1rem;
  }
  .bento .tile { aspect-ratio: auto; transition: transform 0.25s ease, border-color 0.2s; }
  .bento .tile:hover { transform: translateY(-3px); }
  .bento .b-a { grid-column: span 2; grid-row: span 2; }
  .bento .b-a .tile__title { font-size: 1.25rem; }
  @media (max-width: 52rem) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 10rem; }
  }

  .stage { display: grid; grid-template-columns: 1.15fr 1fr; gap: 1rem; }
  .stage__cell {
    position: relative; display: block; min-height: 22rem; overflow: hidden;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-raised); color: var(--text);
    transition: transform 0.25s ease, border-color 0.2s;
  }
  .stage__cell:hover { border-color: var(--accent); transform: translateY(-3px); }
  .stage__cell--doc { background: #fbfaf7; }
  .stage__cell--doc > img { position: absolute; inset: 0 0 4.5rem 0; width: 100%; height: calc(100% - 4.5rem); object-fit: contain; padding: 1.2rem; }
  .phones { position: absolute; inset: 0 0 5.2rem 0; display: flex; justify-content: center; align-items: center; }
  .phones img {
    width: auto; height: 15rem; border-radius: 1.5rem; border: 1px solid var(--border);
    box-shadow: 0 16px 40px -12px rgba(0,0,0,0.55);
  }
  .phones__a { transform: rotate(-5deg) translateX(1.2rem); }
  .phones__b { transform: rotate(5deg) translateX(-1.2rem) translateY(0.8rem); }
  @media (max-width: 52rem) { .stage { grid-template-columns: 1fr; } }

  .thesis p { font-size: 1.02rem; color: var(--text-soft); }

  .tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
  }

  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text);
  }
  .tile:hover { border-color: var(--accent); }

  .tile__media {
    position: absolute;
    inset: 0;
    display: flex;
    background: var(--bg-raised);
  }
  .tile__img, .tile__vid {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PhasePortrait ships its own max-width/aspect-ratio for the hero; inside a
     tile it needs to fill the tile instead. */
  .tile__media :global(.pp) { width: 100%; height: 100%; margin: 0; }
  .tile__media :global(.pp__canvas) {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    aspect-ratio: auto !important;
    border: 0 !important;
    border-radius: 0 !important;
  }
  .tile__img {
    animation: tile-pan 14s ease-in-out infinite alternate;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__img { animation: none; }
  }
  @keyframes tile-pan {
    from { transform: scale(1.06) translate(0, 0); }
    to { transform: scale(1.16) translate(-1.5%, -1.5%); }
  }

  .tile__label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.9rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  }
  .tile__kind {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 0.2rem;
  }
  .tile__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.3;
  }

  .tile--soon {
    border-style: dashed;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
    color: var(--text-muted);
  }
  .tile--soon .tile__kind { color: var(--accent); }
  .tile--soon .tile__title { color: var(--text-soft); font-weight: 600; font-size: 0.95rem; }
  .tile__soon-tag {
    margin: 0.6rem 0 0;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .sel { list-style: none; margin: 0 0 1.75rem; padding: 0; }
  .sel__item {
    display: grid;
    grid-template-columns: 3.75rem 1fr;
    gap: 1.25rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--border);
  }
  .sel__item:last-child { border-bottom: 1px solid var(--border); }
  .sel__year { color: var(--text-muted); font-size: 0.82rem; padding-top: 0.2rem; }
  .sel__title { margin-bottom: 0.3rem; }
  .sel__title a { color: var(--text); border: 0; }
  .sel__title a:hover { color: var(--accent); }
  .sel__note { margin-bottom: 0.25rem; color: var(--text-soft); max-width: 44rem; }
  .sel__venue { margin: 0; }

  @media (max-width: 34rem) {
    .sel__item { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
